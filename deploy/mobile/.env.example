# Copy to .env on the server; never commit the real values.
# Pin every deployed image to registry/name@sha256:<digest>.
# Local builds may instead use the immutable sha256:<image-id>, recorded with a saved image archive.
MOBILE_PROVIDERS=netease,qq
MOBILE_HTTP_PORT=17863
MOBILE_NGINX_IMAGE=
MOBILE_BACKEND_IMAGE=
MOBILE_NETEASE_IMAGE=
MOBILE_QQ_IMAGE=
MOBILE_KUGOU_IMAGE=
MOBILE_ACCESS_TOKEN=
MOBILE_QQ_SECRET=
MOBILE_CERT_FILE=/absolute/path/fullchain.pem
MOBILE_KEY_FILE=/absolute/path/privkey.pem
MOBILE_HTTPS_BIND=0.0.0.0
